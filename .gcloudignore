# Excluded from `gcloud builds submit` uploads.
#
# Used in two places:
#   1. `make publish-ditbox` — submits with the dit repo as source.
#   2. `make dit-cloud`      — submits with a PIPELINE checkout as source,
#                              pointed here explicitly via --ignore-file=...
#                              so .git is preserved in the upload (the
#                              auto-generated default excludes .git, which
#                              breaks workflows that call `git rev-parse`
#                              to compute commit suffixes).
#
# Therefore this file MUST NOT exclude .git/.

__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/

venv/
.venv/
env/

.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

.vscode/
.idea/
.DS_Store

.envrc
.env
.env.local
sa.json
*.key
