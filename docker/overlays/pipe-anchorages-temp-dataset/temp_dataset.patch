+"""DIT test-only overlay: NOT part of pipe-anchorages.
+
+Applied by the data integration tests (DIT) to images they build under
+gcr.io/world-fishing-827/dit/ (see data-integration-tests,
+docker/overlays/pipe-anchorages-temp-dataset/). Never merged upstream.
+
+Beam's ReadFromBigQuery stages every query result in a temporary dataset it
+creates unless it is given one; DIT's service account may not create datasets.
+When DIT_BQ_TEMP_DATASET is set (``<project>.<dataset>``), the reads stage in
+that existing dataset instead. Unset, nothing changes.
+"""
+
+import os
+
+from apache_beam.io.gcp.internal.clients.bigquery import DatasetReference
+
+ENV = "DIT_BQ_TEMP_DATASET"
+
+
+def temp_dataset_kwargs() -> dict:
+    """Extra ReadFromBigQuery kwargs naming the staging dataset, or {} when unset."""
+    value = os.environ.get(ENV, "")
+    if not value:
+        return {}
+    project, _, dataset = value.partition(".")
+    if not project or not dataset:
+        raise ValueError(f"{ENV} must be <project>.<dataset>; got {value!r}")
+    return {"temp_dataset": DatasetReference(projectId=project, datasetId=dataset)}
